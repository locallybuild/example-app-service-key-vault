# The identity Terraform itself is running as - it needs to write the secret.
data "azurerm_client_config" "current" {}

# ---------------------------------------------------------------------------
# Key Vault - holds the secret the app reads.
#
# RBAC authorization is enabled, so access to secrets is granted with Azure
# role assignments (like every other data plane in these examples) rather than
# with the vault's own access policies.
# ---------------------------------------------------------------------------
resource "azurerm_key_vault" "main" {
  # Key Vault names are 3-24 characters, letters, digits and hyphens.
  name                       = "${substr(replace(var.name_prefix, "-", ""), 0, 22)}kv"
  resource_group_name        = azurerm_resource_group.main.name
  location                   = azurerm_resource_group.main.location
  tenant_id                  = data.azurerm_client_config.current.tenant_id
  sku_name                   = "standard"
  rbac_authorization_enabled = true
  soft_delete_retention_days = 7
  purge_protection_enabled   = false
  tags                       = var.tags
}

# ---------------------------------------------------------------------------
# Data-plane role assignments.
#
# With RBAC authorization, nobody can read or write secrets until they hold a
# role on the vault - not even whoever created it. Terraform creates the
# secret below, so the principal running Terraform needs Key Vault Secrets
# Officer (manage secrets, but not keys, certificates or the vault's access).
#
# The app's identity only reads, so it gets Key Vault Secrets User, scoped to
# the one secret it needs rather than the whole vault.
# ---------------------------------------------------------------------------
resource "azurerm_role_assignment" "deployer_secrets_officer" {
  scope                = azurerm_key_vault.main.id
  role_definition_name = "Key Vault Secrets Officer"
  principal_id         = data.azurerm_client_config.current.object_id
}

resource "azurerm_role_assignment" "app_secrets_user" {
  scope                = azurerm_key_vault_secret.demo.resource_versionless_id
  role_definition_name = "Key Vault Secrets User"
  principal_id         = azurerm_user_assigned_identity.app.principal_id
  principal_type       = "ServicePrincipal"
}

# ---------------------------------------------------------------------------
# The secret - a random value generated by Terraform, so it's never written
# down anywhere but the vault (and the Terraform state).
#
# Replacing the random_password (terraform apply -replace=...) generates a new
# value, which Terraform writes as a new version of the same secret - see
# "Rotating the secret" in the README.
# ---------------------------------------------------------------------------
resource "random_password" "demo" {
  length  = 32
  special = false
}

resource "azurerm_key_vault_secret" "demo" {
  name         = "demo-secret"
  value        = random_password.demo.result
  key_vault_id = azurerm_key_vault.main.id
  content_type = "text/plain"

  # Terraform can only write the secret once it holds its role on the vault.
  depends_on = [azurerm_role_assignment.deployer_secrets_officer]
}
